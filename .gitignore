# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
.env
prisma/db/custom.db

