# Database (Prisma + SQLite)
DATABASE_URL=file:./db/custom.db

# ============================================
# AI Provider Configuration
# ============================================
# Choose your AI provider: "openai" or "ollama"
AI_PROVIDER=openai

# --- OpenAI / OpenAI-compatible (OpenAI, Azure, Together, Groq, etc.) ---
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (local) ---
# Single endpoint (simple setup):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=optional-api-key
# OLLAMA_MODEL=llama3.1:8b
# Request timeout in ms. Spans the WHOLE streamed response, not just time-to-first-token.
# OLLAMA_TIMEOUT_MS=120000

# --- Per-action models (optional) ---
# Each variable overrides the model for one AI action. Unset actions use the
# default model above (OLLAMA_MODEL or OPENAI_MODEL). Valid names use only
# letters, digits and ._:/- ; an invalid value is logged and ignored.
# Example: MiniCPM5 variants built from supervisor/modelfiles/ in
# https://github.com/shubhamtaywade82/agent-tui
# AI_MODEL_CHAT=minicpm5-reasoning
# AI_MODEL_FIX=minicpm5-coding-agent
# AI_MODEL_EXPLAIN=minicpm5-summarizer
# AI_MODEL_CONVERT=minicpm5-coding-agent
# AI_MODEL_DIAGRAM=minicpm5-coding-agent
# AI_MODEL_IMPROVE=minicpm5-low-repetition

# Multi-endpoint pool (advanced setup with failover & load balancing):
# priority: HIGHER value is tried first; endpoints with equal priority are balanced
# by OLLAMA_ENDPOINT_STRATEGY. "models" restricts an endpoint/key to those models.
# Option 1: JSON array (recommended for multiple endpoints)
# OLLAMA_ENDPOINTS='[
#   {"name": "ollama-1", "baseUrl": "http://localhost:11434", "apiKey": "key1", "priority": 10, "models": ["llama3.1:8b", "mistral"]},
#   {"name": "ollama-2", "baseUrl": "http://ollama2:11434", "apiKey": "key2", "priority": 5}
# ]'

# Option 2: Discrete env vars (OLLAMA_ENDPOINT_<N>_*)
# OLLAMA_ENDPOINT_1_NAME=ollama-1
# OLLAMA_ENDPOINT_1_BASE_URL=http://localhost:11434
# OLLAMA_ENDPOINT_1_API_KEY=key1
# OLLAMA_ENDPOINT_1_PRIORITY=10
# OLLAMA_ENDPOINT_1_MODELS=llama3.1:8b,mistral
#
# OLLAMA_ENDPOINT_2_NAME=ollama-2
# OLLAMA_ENDPOINT_2_BASE_URL=http://ollama2:11434
# OLLAMA_ENDPOINT_2_API_KEY=key2
# OLLAMA_ENDPOINT_2_PRIORITY=5

# Endpoint selection strategy: "priority" (default), "round-robin", "least-connections"
# OLLAMA_ENDPOINT_STRATEGY=least-connections

# ============================================
# Generative UI (OpenUI Lang) — experimental
# ============================================
# Lets AI chat/explain answers include interactive UI (cards, tables, callouts,
# reviewable edits). Off by default. Measure your model first: npm run eval:genui
# AI_GENERATIVE_UI=1
#
# @openuidev/lang-core sends pseudonymous install telemetry from its postinstall
# script unless disabled. Export this in your shell/CI before installing:
# OPENUI_TELEMETRY_DISABLED=1

# ============================================
# Server workspace (edit folders on the server machine, e.g. inside WSL)
# ============================================
# Off unless set. Comma-separated absolute directories; nothing outside them
# is reachable. See README "Server Workspace".
# WORKSPACE_ROOTS=/home/you/projects,/home/you/notes
# WORKSPACE_MAX_FILE_BYTES=5242880
# WORKSPACE_ALLOWED_HOSTS=

# ============================================
# NextAuth (if using authentication)
# ============================================
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=http://localhost:3000