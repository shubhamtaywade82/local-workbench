# Database (Prisma + SQLite)
DATABASE_URL=file:./db/custom.db

# ============================================
# AI Provider Configuration
# ============================================
# Choose your AI provider: "openai" or "ollama"
AI_PROVIDER=openai

# --- OpenAI / OpenAI-compatible (OpenAI, Azure, Together, Groq, etc.) ---
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (local) ---
# Single endpoint (simple setup):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=optional-api-key
# OLLAMA_MODEL=llama3.1:8b

# Multi-endpoint pool (advanced setup with failover & load balancing):
# Option 1: JSON array (recommended for multiple endpoints)
# OLLAMA_ENDPOINTS='[
#   {"name": "ollama-1", "baseUrl": "http://localhost:11434", "apiKey": "key1", "priority": 1, "models": ["llama3.1:8b", "mistral"]},
#   {"name": "ollama-2", "baseUrl": "http://ollama2:11434", "apiKey": "key2", "priority": 2}
# ]'

# Option 2: Discrete env vars (OLLAMA_ENDPOINT_<N>_*)
# OLLAMA_ENDPOINT_1_NAME=ollama-1
# OLLAMA_ENDPOINT_1_BASE_URL=http://localhost:11434
# OLLAMA_ENDPOINT_1_API_KEY=key1
# OLLAMA_ENDPOINT_1_PRIORITY=1
# OLLAMA_ENDPOINT_1_MODELS=llama3.1:8b,mistral
#
# OLLAMA_ENDPOINT_2_NAME=ollama-2
# OLLAMA_ENDPOINT_2_BASE_URL=http://ollama2:11434
# OLLAMA_ENDPOINT_2_API_KEY=key2
# OLLAMA_ENDPOINT_2_PRIORITY=2

# Endpoint selection strategy: "priority" (default), "round-robin", "least-connections"
# OLLAMA_ENDPOINT_STRATEGY=least-connections

# ============================================
# NextAuth (if using authentication)
# ============================================
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=http://localhost:3000